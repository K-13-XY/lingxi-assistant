# ============================================================
# 灵犀智能助手 —— 统一配置
# ============================================================

# ===================== DeepSeek（对话/生成模型） ====================
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=你的APIKEY

# ===================== 阿里云百炼（Embedding 向量化） ====================
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=你的APIKEY
EMBEDDING_BASE_URL=https://ws-7wf9penseh42v83r.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ===================== Redis（对话记忆 Checkpointer） ====================
REDIS_URL=你的REDISURL

# ===================== PostgreSQL（用户数据） ====================
DATABASE_URL=你的PostgreSQK

# ===================== Milvus（向量数据库） ====================
# 本地模式（Milvus Lite，Windows 可用）：./data/milvus_kb.db
# 服务器模式：http://<host>:19530
KB_MILVUS_URI=./data/milvus_kb.db
KB_MILVUS_DB=default
KB_MILVUS_COLLECTION=rag_kb

# ===================== 检索与切分 ====================
TOP_K=4
SCORE_THRESHOLD=0.55   # 余弦相似度下限，低于此视为“无相关内容”
CHUNK_SIZE=500
CHUNK_OVERLAP=50
